<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/pinni-vamshi/clipen-releases/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>1OxuVCxbGaZ4VWRSyCNhlcep+BRMKhSnAyG8/xqGmqU=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- DO NOT SET THESE TWO KEYS TO true YET. Prepared in advance so that if
	     the Sparkle EdDSA private key is ever lost again (as happened once
	     already, after a factory reset), already-installed old copies of
	     Clipen have a way to eventually accept a new key instead of being
	     stuck forever. Enabling SURequireSignedFeed with no actually-signed
	     feed will make Sparkle reject EVERY future appcast fetch for anyone
	     who gets a build with this flag on — do not flip this to true until
	     the release pipeline is updated to run `generate_appcast` (which
	     signs the appcast/release-note files) against the FULL archives
	     directory, not the hand-spliced appcast.xml this project currently
	     maintains. Once that's true, both keys below need to be true. -->
	<key>SUVerifyUpdateBeforeExtraction</key>
	<false/>
	<key>SURequireSignedFeed</key>
	<false/>
	<!-- Screenshot to Clipboard watches the folder macOS saves screenshots
	     to (Desktop unless the user changed it). macOS gates that folder
	     behind Files-and-Folders TCC even for non-sandboxed apps, and a
	     denied read fails silently, so without this string the prompt has
	     no explanation and the feature can look simply broken. -->
	<key>NSDesktopFolderUsageDescription</key>
	<string>Clipen watches your screenshot folder so new screenshots can be copied to your clipboard automatically. Only used when "Screenshot to Clipboard" is turned on.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Clipen only needs this if you have changed your screenshot save location to a folder inside Documents.</string>
</dict>
</plist>
